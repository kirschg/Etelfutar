<Window x:Class="EtelfutarWPF.Windows.EditLearazasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EtelfutarWPF.Windows"
        mc:Ignorable="d"
        Background="#404040"
        Title="Ételfutár | Leárazás Módosítása" Height="250" Width="400">
    <StackPanel>
        <Label Foreground="White" Content="Étterem Id" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_etterem_id" Width="100"></TextBox>
        <Label Foreground="White" Content="Étel Id" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_etel_id" Width="100"></TextBox>
        <Label Foreground="White" Content="Leárazás" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_learazas" Width="100"></TextBox>
        <Button Click="Modositas_Click" Content="Módosítás" Width="100" Margin="0,10,0,0" Background="#b3001c"></Button>
        <Button Click="Megse_Click" Content="Mégse" Width="100" Margin="0,10,0,0"></Button>
    </StackPanel>
</Window>
