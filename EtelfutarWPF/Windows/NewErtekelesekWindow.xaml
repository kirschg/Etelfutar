<Window x:Class="EtelfutarWPF.Windows.NewErtekelesekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EtelfutarWPF.Windows"
        mc:Ignorable="d"
        Background="#404040"
        Title="Ételfutár | Új Értékelés" Height="450" Width="400">
    <StackPanel>
        <Label Content="Felhasználó Id" Foreground="White" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_felhasznalo_id" Width="100"></TextBox>
        <Label Content="Étterem Id" Foreground="White" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_etterem_id" Width="100"></TextBox>
        <Label Content="Szöveg" Foreground="White" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_szoveg" Width="100"></TextBox>
        <Label Content="Értékelés" Foreground="White" HorizontalAlignment="Center"></Label>
        <TextBox Name="tbx_ertekeles" Width="100"></TextBox>
        <Button Click="Mentes_Click" Content="Mentés" Width="100" Margin="0,10,0,0" Background="#b3001c"></Button>
        <Button Click="Megse_Click" Content="Mégse" Width="100" Margin="0,10,0,0"></Button>
    </StackPanel>
</Window>
