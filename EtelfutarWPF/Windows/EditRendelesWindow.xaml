<Window x:Class="EtelfutarWPF.EditRendelesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EtelfutarWPF"
        mc:Ignorable="d"
        Background="#404040"
        Title="EditRendelesWindow" Height="450" Width="400">
    <StackPanel>
        <Label Foreground="White" Content="Felhasznalo Id" HorizontalAlignment="Center"></Label>
        <TextBox Width="100" Name="tbx_felhasznalo_id"></TextBox>
        <Label Foreground="White" Content="Össz Ár" HorizontalAlignment="Center"></Label>
        <TextBox Width="100" Name="tbx_ossz_ar"></TextBox>
        <Button Click="Modositas_Click" Content="Módosítás" Width="100" Margin="0,10,0,0" Background="#b3001c"></Button>
        <Button Click="Megse_Click" Content="Mégse" Width="100" Margin="0,10,0,0"></Button>
    </StackPanel>
</Window>
